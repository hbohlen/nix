#!/bin/sh
# bin/devenv — the pinned devenv for this repository.
#
# WHY THIS EXISTS: the `devenv machines` subcommand needs devenv 2.4 or newer,
# and nixpkgs still ships 2.3.1 (measured 2026-09-27). The operator's global
# profile binary is 2.2.2, and replacing it would change every other project on
# this workstation — so this repo carries its own toolchain instead:
#
#   nix build 'github:cachix/devenv/v2.4.0#devenv' --out-link .devenv-toolchain \
#     --option extra-substituters https://devenv.cachix.org \
#     --option extra-trusted-public-keys "devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw="
#
# The substituter flags matter: this host has no cachix substituter configured,
# so without them nix compiles the whole Rust workspace instead of fetching the
# prebuilt wrapper. Verified: `devenv --version` reports 2.4.0+b904dcb.
#
# Use `bin/devenv …` for machine commands, never bare `devenv` — on a
# workstation. The rule is workstation-only (design R7 trade-off): on this host
# the operator's home-manager role installs a bare `devenv` pinned to the SAME
# 2.4.0 as this script (hosts/netcup/operator.nix), so there the two names agree
# by construction.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exe="$here/../.devenv-toolchain/bin/devenv"

if [ ! -x "$exe" ]; then
  cat >&2 <<'EOF'
bin/devenv: the pinned toolchain is missing (or was garbage-collected).
Rebuild it:

  nix build 'github:cachix/devenv/v2.4.0#devenv' --out-link .devenv-toolchain \
    --option extra-substituters https://devenv.cachix.org \
    --option extra-trusted-public-keys "devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw="
EOF
  exit 1
fi

exec "$exe" "$@"
