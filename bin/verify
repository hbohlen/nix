#!/bin/sh
# bin/verify - re-measure the facts the repo's comments record, in one command.
#
# WHY THIS EXISTS: the comments record measured facts with dates, for example
# the "KNOWN GAP, RE-MEASURED 2026-09-30" block in modules/ingress.nix. Those
# facts decay silently as the hosts move. The re-measurement checks all exist
# already, scattered across the shell config and the tasks, so a reader who
# doubts a claim had no single command to re-run. This aggregates the four.
#
#   1. a Nix syntax sweep over every Nix file the repo tracks outside the
#      vendored skill directories
#   2. `bin/devenv test`, the enterTest smoke in modules/shell.nix
#   3. `bin/devenv tasks run ingress:smoke`
#   4. `bin/devenv tasks run dsh:smoke`
#
# This needs no vault and no secret. `devenv test` is deliberately tokenless
# here (devenv.yaml keeps secretspec.enable false) and the two smoke tasks read
# no secret.
#
# The chain stops at the first failing check and names it. The closing line
# names only the checks that really ran, because a green summary over an
# unchecked chain is the lie this file exists to prevent.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

passed=""

fail() {
  printf '%s\n' "bin/verify: $1 failed${2:+ ($2)}" >&2
  printf '%s\n' "bin/verify: passed before the failure: ${passed:-nothing}" >&2
  exit 1
}

command -v nix-instantiate >/dev/null 2>&1 || fail "the Nix syntax sweep" "nix-instantiate is not on PATH"

files=$(git ls-files '*.nix') || fail "the Nix syntax sweep" "git ls-files could not list the repo's Nix files"
[ -n "$files" ] || fail "the Nix syntax sweep" "git ls-files listed no Nix files"

checked=0
broken=0
# A read loop rather than for f in $files, so a path with spaces stays one path.
while IFS= read -r f; do
  case "$f" in
    .agents/*|.pi/*|.qoder/*|.opencode/*) continue ;;
  esac
  checked=$((checked + 1))
  nix-instantiate --parse "$f" >/dev/null || {
    printf '%s\n' "bin/verify: nix parse failed: $f" >&2
    broken=$((broken + 1))
  }
done <<EOF
$files
EOF
[ "$broken" -eq 0 ] || fail "the Nix syntax sweep" "$broken of $checked tracked Nix files do not parse"
passed="${passed:+$passed, }Nix syntax sweep ($checked files)"

bin/devenv test --no-tui || fail "bin/devenv test"
passed="${passed:+$passed, }bin/devenv test"

bin/devenv tasks run ingress:smoke --no-tui || fail "devenv tasks run ingress:smoke"
passed="${passed:+$passed, }ingress:smoke"

bin/devenv tasks run dsh:smoke --no-tui || fail "devenv tasks run dsh:smoke"
passed="${passed:+$passed, }dsh:smoke"

printf '%s\n' "bin/verify: passed $passed"
